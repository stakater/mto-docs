{
  "name": "mto-docs-testcafe-tests",
  "version": "1.0.0",
  "dependencies": {
    "testcafe": "^3.3.0",
    "dotenv": "^16.3.1",
    "minimatch": "^10.0.3"
  },
  "scripts": {
    "local": "testcafe chrome src/**.ts",
