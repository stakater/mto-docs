# Copy to screenshots/.env (gitignored). Credentials only — the rest is in config.env.
# In CI these two are the secrets.
#
# No quotes, no inline comments (docker keeps everything after = literally).

# Must be an admin: Operator Settings and the create/delete actions need it.
CONSOLE_USER=mto-admin@stakater.com
CONSOLE_PASSWORD=changeme

# Anything in config.env can be overridden here, e.g.:
# CONSOLE_URL=https://console.example.com
