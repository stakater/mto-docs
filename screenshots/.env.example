# Copy to screenshots/.env (gitignored) and fill in. In CI these come from GitHub
# Actions secrets instead of this file.
#
# TWO RULES, both of which have already broken a run:
#   1. NO inline comments. `docker --env-file` only treats a line as a comment when
#      `#` is the FIRST character; otherwise everything after `=` is the value,
#      so `FOO=bar # note` literally becomes "bar # note".
#   2. NO quotes and NO trailing slash on the URL (the flows append /tenants etc).

# --- Connection -------------------------------------------------------------
# Used by: every flow (the login block at the top of each one).
CONSOLE_URL=https://tenant-operator-multi-tenant-operator.apps.alpha-dev.stakater.cloud
# Must be an ADMIN: the configuration flow needs the admin-only Operator Settings
# page, and create/delete actions are hidden from non-admins.
CONSOLE_USER=mto@stakater.com
CONSOLE_PASSWORD=changeme

# --- Tenant used for the tenants page --------------------------------------
# Used by: tenants (opens this tenant's detail page for the Graph, Quota and
# Utilization tab screenshots).
DOCS_TENANT=retail

# Used by: tenants (the namespace drilled into for the Utilization stats shot),
# template-instances (the namespace the instance is created in), and
# cluster-template-instances (the single namespace its selector targets, which is
# what keeps the CTI from fanning out across the cluster).
DOCS_NAMESPACE=retail-dev

# Used by: tenants-create (picked in the Create Tenant drawer's Quota dropdown).
# Must be an EXISTING quota name -- the drawer offers no others, so a wrong value
# fails at that dropdown. alpha-dev has exactly one, and it is also what the
# original tenant-overview.png shows selected.
DOCS_QUOTA=nordmart-large

# --- Hibernation ------------------------------------------------------------
# Used by: hibernation and _teardown (scopes the namespace list to this tenant;
# nothing on that page works until a tenant is selected).
DOCS_HIB_TENANT=logistics

# Used by: hibernation, which really puts this namespace to SLEEP (instantly) and
# then screenshots the list showing its Sleeping badge + Wake up button.
# _teardown wakes it again. MUST be Active before a run: the drawer disables the
# row for a namespace that is already asleep.
DOCS_SLEEP_NS=logistics-prod

# Used by: hibernation, which really puts this namespace on the schedule it creates
# (Hibernating badge in the same shot). _teardown deletes the schedule, which wakes
# it. MUST also be Active before a run.
DOCS_HIB_NS=logistics-test

# --- Not configurable -------------------------------------------------------
# Templates, instances, the hibernation schedule and the node filter are all
# CREATED by the flows under fixed docs-* names and deleted by _teardown:
#   docs-seed-template (_seed)   docs-template (templates)
#   docs-instance (template-instances)   docs-cti-instance (cluster-template-instances)
#   docs-weekend-shutdown (hibernation)  docs-gpu-nodes (capacity-planning)
