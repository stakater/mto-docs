# Capture config, checked in. Credentials live in .env.
# No quotes, no inline comments (docker keeps everything after = literally).

# Console to capture against. No trailing slash.
CONSOLE_URL=https://tenant-operator-multi-tenant-operator.apps.alpha-dev.stakater.cloud

# tenants: tenant whose detail tabs are shot.
DOCS_TENANT=retail

# tenants: namespace for the Utilization drill-down. template-instances: where the
# instance is created. cluster-template-instances: the only namespace it targets.
DOCS_NAMESPACE=retail-dev

# tenants-create: quota picked in the Create Tenant drawer. Must already exist.
DOCS_QUOTA=nordmart-large

# hibernation, _teardown: tenant to scope the namespace list to.
DOCS_HIB_TENANT=logistics

# hibernation: really put to sleep, then shot; _teardown wakes it.
# Must be Active before a run (the drawer skips namespaces already asleep).
DOCS_SLEEP_NS=logistics-prod

# hibernation: really hibernated on the flow's schedule; _teardown deletes the
# schedule, which wakes it. Must also be Active.
DOCS_HIB_NS=logistics-test
